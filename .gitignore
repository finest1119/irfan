.env
.env.*
__pycache__/
*.pyc
output/
*.blend1
screenshots/
.venv/
.DS_Store

# Poly Haven / Kenney downloads for the v2 look (large binaries, CC0; keep out of git)
assets/polyhaven/

# per-machine path overrides for pipeline/platform_cfg.py (Blender/ffmpeg/fonts; never secrets)
config_local.json

# CC0 3D assets for the Page 2 world (Poly Haven models/textures, Kenney kits); re-fetch with tools/fetch_cc0.py
assets/cc0/*
!assets/cc0/manifest.json

# local-only (personal info / third-party reference images / logs)
page3/PAGE-SETUP-REPORT.md
branding/thumbnail-reference/
page3/branding/logo-v2/*.log
